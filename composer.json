{
	"name": "fairway/netx-fal",
	"version": "1.0.0",
	"authors": [
		{
			"name": "eCentral GmbH",
			"role": "Project Owner",
			"email": "support@ecentral.de",
			"homepage": "https://www.ecentral.de"
		}
	],
	"type": "typo3-cms-extension",
	"description": "",
	"homepage": "https://www.ecentral.de",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"typo3 backend",
		"netx"
	],
	"autoload": {
		"psr-4": {
			"Fairway\\NetXFal\\": "Classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		},
		"vendor-dir": ".Build/vendor",
		"bin-dir": ".Build/bin",
		"preferred-install": {
			"typo3/cms-core": "source"
		},
		"sort-packages": true
	},
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^12 || ^13",
		"guzzlehttp/psr7": "*",
		"fairway/netx-fal-api": "*",
		"ext-fileinfo": "*",
		"ext-curl": "*",
		"ext-gd": "*"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.30",
		"phpstan/phpstan": "^1.8.0",
		"saschaegerer/phpstan-typo3": "^1.8.0",
		"typo3/cms-frontend": "^12 || ^13",
		"typo3/cms-install": "^12 || ^13",
		"typo3/cms-filelist": "^12 || ^13",
		"typo3/testing-framework": "^8.0.9"
	},
	"scripts": {
		"phpcsfixer": "php-cs-fixer fix --dry-run --diff --using-cache=no --config=.php-cs-fixer.dist.php",
		"phpstan": "phpstan analyse Classes Configuration ext_emconf.php ext_localconf.php --level=5"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"typo3/cms": {
			"app-dir": ".Build",
			"web-dir": ".Build/Web",
			"extension-key": "netx_fal"
		}
	}
}
